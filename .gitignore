# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# claude — commit shared agents + skills; keep machine-local settings and
# worktree checkouts out of git (settings.local.json has held secrets).
/.claude/*
!/.claude/agents/
!/.claude/skills/
/.claude/settings.local.json
/.claude/worktrees/

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env.local
public/uploads/

# Local content dumps from scripts/pull-series.cjs and rewrites awaiting push.
# The .cjs scripts in scripts/ are committed; the dumped/rewritten markdown is not.
/scripts/series/
public/figures/_*.svg
__pycache__/
scripts/seo-history-inline/

# --- local dev & design scratch (never deployed; prod builds on Railway/Nixpacks) ---
# Local Docker dev stack — a root Dockerfile would otherwise hijack Railway's build
/Dockerfile
/docker-compose.yml
/.dockerignore
/docker/
# Design exploration, mockups, and decks
/_v2_light.html
/concept-*.html
/demo-*.html
/portfolio-*.html
/series-map.html
/series-outlines.html
/series-review.html
/showcase-*.html
/showcase-brief.md
/mock/
/deck-shots/
/project-media/
# Cover/thumbnail experiments and unused work media
/public/covers-v2/
/public/covers-v3/
/public/work/
# One-off / debug scripts
/scripts/_tmp_*.cjs
/scripts/dbcheck.cjs
/scripts/dump-*.cjs
/scripts/figure2.py
/scripts/make-covers-*.py
/scripts/verify-figs.cjs
